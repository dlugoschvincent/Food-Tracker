{
	"name": "food-tracker",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "NODE_OPTIONS='--inspect-brk=0.0.0.0' vite dev",
		"format": "NODE_OPTIONS='--experimental-strip-types' prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prebuild": "prisma generate",
		"predev": "prisma generate && prisma db push --accept-data-loss",
		"prestart": "prisma db push --accept-data-loss",
		"preview": "vite preview",
		"start": "node build"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.7.4",
		"@auth/sveltekit": "^1.7.4",
		"@ericblade/quagga2": "^1.8.4",
		"@prisma/client": "^6.3.1"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.304",
		"@playwright/test": "^1.50.1",
		"@sveltejs/adapter-node": "5.2.12",
		"@sveltejs/kit": "^2.17.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "^9.6.1",
		"@unocss/extractor-svelte": "^65.4.3",
		"eslint": "^9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.5.0",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-package": "^1.4.0",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "^6.3.1",
		"svelte": "^5.19.9",
		"svelte-check": "^4.1.4",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.23.0",
		"unocss": "^65.4.3",
		"vite": "^6.1.0"
	}
}
